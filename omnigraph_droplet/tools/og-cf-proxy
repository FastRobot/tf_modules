#!/usr/bin/env python3
"""og-cf-proxy: reach an omnigraph_droplet server through Cloudflare Access.

The omnigraph CLI cannot send Cloudflare Access credentials: it sends only a
token68 bearer token, and Access wants either its own OAuth token (which
contains a colon) or service-token headers. It does allow plain HTTP to an
anonymous loopback server, so this proxy listens on 127.0.0.1 and adds the
credentials on the way out:

  oauth mode (people)  Google sign-in through Access Managed OAuth, to the
                       browser hostname. Caddy maps the signed-in email to
                       that person's OmniGraph actor.
  service mode (CI)    CF-Access-Client-Id/-Secret plus an OmniGraph bearer
                       token, to the API hostname. Selected when
                       CF_ACCESS_CLIENT_ID is set; also needs
                       CF_ACCESS_CLIENT_SECRET and OMNIGRAPH_TOKEN.

Any local process that can reach the listener acts as you while it runs.

Commands:
  og-cf-proxy login  [--upstream URL]       sign in once (opens a browser)
  og-cf-proxy logout [--upstream URL]       forget the stored sign-in
  og-cf-proxy serve  [--upstream URL] [--listen 127.0.0.1:PORT]
  og-cf-proxy exec   [--upstream URL] [--listen ...] -- omnigraph ...
                                            run one command through the proxy
                                            (reuses a proxy already listening)

--upstream defaults to $OG_CF_UPSTREAM; --listen to $OG_CF_LISTEN, else
127.0.0.1:8787. OAuth sign-ins are kept in the macOS keychain (service
"og-cf-proxy"), elsewhere in ~/.config/og-cf-proxy/ with mode 0600.
"""

import argparse
import base64
import errno
import hashlib
import http.client
import http.server
import json
import os
import secrets
import signal
import socket
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

DEFAULT_LISTEN = "127.0.0.1:8787"
STATUS_PATH = "/.og-cf-proxy/status"
KEYCHAIN_SERVICE = "og-cf-proxy"
UPSTREAM_TIMEOUT = 300
REFRESH_MARGIN = 60
CHUNK = 64 * 1024

# RFC 9110 hop-by-hop headers, plus what this proxy owns.
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "proxy-connection", "te", "trailer", "transfer-encoding", "upgrade",
}
OWNED_REQUEST = {"host", "authorization", "cf-access-client-id",
                 "cf-access-client-secret", "cf-access-token", "content-length"}


def die(message):
    print(f"og-cf-proxy: {message}", file=sys.stderr)
    sys.exit(2)


def normalize_upstream(url):
    if not url:
        die("no upstream: pass --upstream https://HOST or set OG_CF_UPSTREAM")
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or not parsed.hostname:
        die(f"upstream must be an https:// URL, got {url!r}")
    if parsed.path not in ("", "/") or parsed.query or parsed.fragment:
        die("upstream must be an origin (https://HOST[:PORT]) without a path")
    return f"https://{parsed.netloc}"


def parse_listen(value):
    host, sep, port = value.rpartition(":")
    if not sep or not port.isdigit():
        die(f"--listen must be HOST:PORT, got {value!r}")
    host = host.strip("[]")
    if host not in ("127.0.0.1", "::1", "localhost"):
        die("refusing to listen off loopback: anyone who can connect acts as you")
    return host, int(port)


# --- stored OAuth sign-in -------------------------------------------------


class Store:
    """One JSON record per upstream: OAuth endpoints, client id, tokens."""

    def __init__(self, upstream):
        self.account = upstream
        self.keychain = sys.platform == "darwin"
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        name = urllib.parse.quote(upstream, safe="") + ".json"
        self.path = os.path.join(base, "og-cf-proxy", name)

    def load(self):
        if self.keychain:
            out = subprocess.run(
                ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
                 "-a", self.account, "-w"],
                capture_output=True, text=True)
            return json.loads(out.stdout) if out.returncode == 0 else None
        try:
            with open(self.path) as f:
                return json.load(f)
        except FileNotFoundError:
            return None

    def save(self, record):
        data = json.dumps(record, separators=(",", ":"))
        if self.keychain:
            subprocess.run(
                ["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE,
                 "-a", self.account, "-w", data],
                check=True, capture_output=True)
            return
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        tmp = self.path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(data)
        os.replace(tmp, self.path)

    def delete(self):
        if self.keychain:
            subprocess.run(
                ["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE,
                 "-a", self.account], capture_output=True)
            return
        try:
            os.remove(self.path)
        except FileNotFoundError:
            pass


def http_json(url, form=None, body=None):
    """GET, or POST a form or JSON body; returns (status, parsed JSON or None)."""
    headers = {"Accept": "application/json", "User-Agent": "og-cf-proxy"}
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.status, json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        raw = error.read()
        try:
            return error.code, json.loads(raw)
        except ValueError:
            return error.code, {"error": raw.decode(errors="replace")[:500]}


def discover(upstream):
    status, resource = http_json(upstream + "/.well-known/oauth-protected-resource")
    if status != 200 or not resource.get("authorization_servers"):
        die(f"{upstream} publishes no OAuth protected-resource metadata (HTTP {status});"
            " is Access Managed OAuth enabled on its browser application?")
    issuer = resource["authorization_servers"][0].rstrip("/")
    status, meta = http_json(issuer + "/.well-known/oauth-authorization-server")
    if status != 200:
        die(f"authorization server metadata at {issuer}: HTTP {status}")
    return {
        "resource": resource.get("resource", upstream),
        "authorization_endpoint": meta["authorization_endpoint"],
        "token_endpoint": meta["token_endpoint"],
        "registration_endpoint": meta["registration_endpoint"],
        "revocation_endpoint": meta.get("revocation_endpoint"),
    }


def apply_token_response(record, tokens):
    record["access_token"] = tokens["access_token"]
    record["expires_at"] = int(time.time()) + int(tokens.get("expires_in", 900))
    if tokens.get("refresh_token"):
        record["refresh_token"] = tokens["refresh_token"]
    return record


def login(upstream):
    meta = discover(upstream)

    code_holder = {}
    state = secrets.token_urlsafe(24)

    class Callback(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if urllib.parse.urlsplit(self.path).path != "/callback":
                self.send_error(404)
                return
            if query.get("state", [""])[0] != state:
                self.send_error(400, "state mismatch")
                return
            code_holder.update({k: v[0] for k, v in query.items()})
            message = "Signed in. You can close this tab." if "code" in query else \
                f"Sign-in failed: {query.get('error', ['unknown'])[0]}"
            body = message.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Callback)
    redirect_uri = f"http://127.0.0.1:{server.server_port}/callback"

    status, client = http_json(meta["registration_endpoint"], body={
        "client_name": f"og-cf-proxy ({socket.gethostname()})",
        "redirect_uris": [redirect_uri],
        "grant_types": ["authorization_code", "refresh_token"],
        "response_types": ["code"],
        "token_endpoint_auth_method": "none",
    })
    if status not in (200, 201) or "client_id" not in client:
        die(f"client registration refused (HTTP {status}): {client}")

    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    url = meta["authorization_endpoint"] + "?" + urllib.parse.urlencode({
        "response_type": "code",
        "client_id": client["client_id"],
        "redirect_uri": redirect_uri,
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "resource": meta["resource"],
    })
    print(f"Opening your browser to sign in. If it does not open, visit:\n  {url}",
          file=sys.stderr)
    webbrowser.open(url)

    server.timeout = 300
    deadline = time.time() + 300
    while "code" not in code_holder and "error" not in code_holder:
        if time.time() > deadline:
            die("timed out waiting for the browser sign-in")
        server.handle_request()
    server.server_close()
    if "error" in code_holder:
        die(f"sign-in failed: {code_holder.get('error')}"
            f" {code_holder.get('error_description', '')}".rstrip())

    status, tokens = http_json(meta["token_endpoint"], form={
        "grant_type": "authorization_code",
        "code": code_holder["code"],
        "redirect_uri": redirect_uri,
        "client_id": client["client_id"],
        "code_verifier": verifier,
        "resource": meta["resource"],
    })
    if status != 200 or "access_token" not in tokens:
        die(f"token exchange refused (HTTP {status}): {tokens.get('error', tokens)}")
    record = apply_token_response({**meta, "client_id": client["client_id"]}, tokens)
    Store(upstream).save(record)
    refresh = "with" if record.get("refresh_token") else "WITHOUT"
    print(f"Signed in to {upstream} ({refresh} a refresh token).", file=sys.stderr)


def logout(upstream):
    store = Store(upstream)
    record = store.load()
    if record and record.get("revocation_endpoint") and record.get("refresh_token"):
        http_json(record["revocation_endpoint"], form={
            "token": record["refresh_token"], "token_type_hint": "refresh_token",
            "client_id": record["client_id"]})
    store.delete()
    print(f"Signed out of {upstream}.", file=sys.stderr)


# --- credentials attached to forwarded requests ---------------------------


class OAuthCredentials:
    mode = "oauth"

    def __init__(self, upstream):
        self.store = Store(upstream)
        self.lock = threading.Lock()
        self.record = self.store.load()

    def check(self):
        if not self.record:
            die(f"not signed in to {self.store.account}; run: og-cf-proxy login"
                f" --upstream {self.store.account}")

    def headers(self):
        with self.lock:
            record = self.record
            if record is None:
                raise CredentialError("not signed in; run og-cf-proxy login")
            if record.get("expires_at", 0) - REFRESH_MARGIN < time.time():
                self._refresh()
            return {"Authorization": "Bearer " + self.record["access_token"]}

    def _refresh(self):
        record = self.record
        if not record.get("refresh_token"):
            raise CredentialError("sign-in expired; run og-cf-proxy login")
        status, tokens = http_json(record["token_endpoint"], form={
            "grant_type": "refresh_token",
            "refresh_token": record["refresh_token"],
            "client_id": record["client_id"],
            "resource": record["resource"],
        })
        if status != 200 or "access_token" not in tokens:
            raise CredentialError(
                f"refresh refused (HTTP {status}); run og-cf-proxy login")
        self.record = apply_token_response(dict(record), tokens)
        self.store.save(self.record)

    def rejected(self):
        """Upstream refused the token: refresh before the next request."""
        with self.lock:
            if self.record:
                self.record["expires_at"] = 0


class ServiceCredentials:
    mode = "service"

    def __init__(self):
        missing = [name for name in ("CF_ACCESS_CLIENT_ID", "CF_ACCESS_CLIENT_SECRET",
                                     "OMNIGRAPH_TOKEN") if not os.environ.get(name)]
        if missing:
            die("service mode needs " + ", ".join(missing))
        self.fixed = {
            "CF-Access-Client-Id": os.environ["CF_ACCESS_CLIENT_ID"],
            "CF-Access-Client-Secret": os.environ["CF_ACCESS_CLIENT_SECRET"],
            "Authorization": "Bearer " + os.environ["OMNIGRAPH_TOKEN"],
        }

    def check(self):
        pass

    def headers(self):
        return self.fixed

    def rejected(self):
        pass


class CredentialError(Exception):
    pass


# --- the proxy ------------------------------------------------------------


def read_chunked(rfile):
    """Decode a chunked request body from the client, yielding chunks."""
    while True:
        line = rfile.readline(1024)
        size = int(line.split(b";", 1)[0].strip() or b"0", 16)
        if size == 0:
            while rfile.readline(1024) not in (b"\r\n", b"\n", b""):
                pass
            return
        remaining = size
        while remaining:
            data = rfile.read(min(remaining, CHUNK))
            if not data:
                raise ConnectionError("client closed mid-body")
            remaining -= len(data)
            yield data
        rfile.readline(1024)


def read_sized(rfile, length):
    remaining = length
    while remaining:
        data = rfile.read(min(remaining, CHUNK))
        if not data:
            raise ConnectionError("client closed mid-body")
        remaining -= len(data)
        yield data


def make_handler(upstream, credentials):
    host = urllib.parse.urlsplit(upstream).hostname
    port = urllib.parse.urlsplit(upstream).port or 443
    tls = ssl.create_default_context()

    class Proxy(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "og-cf-proxy"

        def log_message(self, *args):
            pass

        def _plain(self, status, message):
            body = (message + "\n").encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _forward(self):
            if self.path == STATUS_PATH:
                body = json.dumps({"upstream": upstream, "mode": credentials.mode}).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            try:
                auth = credentials.headers()
            except CredentialError as error:
                self.close_connection = True
                self._plain(401, f"og-cf-proxy: {error}")
                return

            headers = {}
            for name, value in self.headers.items():
                lower = name.lower()
                if lower in HOP_BY_HOP or lower in OWNED_REQUEST:
                    continue
                headers[name] = value
            headers.update(auth)

            if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
                body, chunked = read_chunked(self.rfile), True
            else:
                length = int(self.headers.get("Content-Length") or 0)
                body, chunked = (read_sized(self.rfile, length) if length else None), False
                if length:
                    headers["Content-Length"] = str(length)

            connection = http.client.HTTPSConnection(
                host, port, timeout=UPSTREAM_TIMEOUT, context=tls)
            try:
                try:
                    connection.request(self.command, self.path, body=body,
                                       headers=headers, encode_chunked=chunked)
                    response = connection.getresponse()
                except (OSError, http.client.HTTPException) as error:
                    self.close_connection = True
                    self._plain(502, f"og-cf-proxy: upstream {upstream}: {error}")
                    return
                if response.status in (401, 403) and \
                        "cloudflareaccess.com" in response.getheader("Location", "") + \
                        response.getheader("WWW-Authenticate", ""):
                    credentials.rejected()
                self._relay(response)
            finally:
                connection.close()

        def _relay(self, response):
            self.send_response_only(response.status, response.reason)
            length = response.getheader("Content-Length")
            bodyless = self.command == "HEAD" or response.status in (204, 304) \
                or 100 <= response.status < 200
            for name, value in response.getheaders():
                if name.lower() in HOP_BY_HOP or name.lower() == "content-length":
                    continue
                self.send_header(name, value)
            if bodyless:
                if length is not None:
                    self.send_header("Content-Length", length)
                self.end_headers()
                return
            if length is not None:
                self.send_header("Content-Length", length)
                self.end_headers()
                while data := response.read(CHUNK):
                    self.wfile.write(data)
                return
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            while data := response.read1(CHUNK):
                self.wfile.write(b"%x\r\n%s\r\n" % (len(data), data))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")

        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _forward

    return Proxy


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, address, handler):
        family = socket.AF_INET6 if ":" in address[0] else socket.AF_INET
        self.address_family = family
        super().__init__(address, handler)


def credentials_for(upstream):
    if os.environ.get("CF_ACCESS_CLIENT_ID"):
        return ServiceCredentials()
    return OAuthCredentials(upstream)


def running_proxy(listen):
    host, port = listen
    try:
        connection = http.client.HTTPConnection(host, port, timeout=5)
        connection.request("GET", STATUS_PATH)
        response = connection.getresponse()
        return json.loads(response.read()) if response.status == 200 else None
    except (OSError, ValueError, http.client.HTTPException):
        return None


def serve(upstream, listen):
    credentials = credentials_for(upstream)
    credentials.check()
    server = Server(listen, make_handler(upstream, credentials))
    print(f"og-cf-proxy: http://{listen[0]}:{listen[1]} -> {upstream}"
          f" ({credentials.mode} mode)", file=sys.stderr)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def run_exec(upstream, listen, command):
    if not command:
        die("exec needs a command after --")
    credentials = credentials_for(upstream)
    credentials.check()
    try:
        server = Server(listen, make_handler(upstream, credentials))
    except OSError as error:
        if error.errno != errno.EADDRINUSE:
            raise
        status = running_proxy(listen)
        if not status:
            die(f"{listen[0]}:{listen[1]} is in use by something other than og-cf-proxy")
        if status["upstream"] != upstream:
            die(f"the proxy on {listen[0]}:{listen[1]} forwards to {status['upstream']},"
                f" not {upstream}")
        server = None
    if server:
        threading.Thread(target=server.serve_forever, daemon=True).start()
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        child = subprocess.Popen(command, preexec_fn=lambda: signal.signal(
            signal.SIGINT, signal.SIG_DFL))
    except FileNotFoundError:
        die(f"command not found: {command[0]}")
    signal.signal(signal.SIGTERM, lambda *_: child.terminate())
    code = child.wait()
    if server:
        server.shutdown()
    sys.exit(code if code >= 0 else 128 - code)


def main():
    parser = argparse.ArgumentParser(
        prog="og-cf-proxy", description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("login", "logout", "serve", "exec"):
        p = sub.add_parser(name)
        p.add_argument("--upstream", default=os.environ.get("OG_CF_UPSTREAM"))
        if name in ("serve", "exec"):
            p.add_argument("--listen", default=os.environ.get("OG_CF_LISTEN", DEFAULT_LISTEN))
        if name == "exec":
            p.add_argument("argv", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    upstream = normalize_upstream(args.upstream)

    if args.command == "login":
        login(upstream)
    elif args.command == "logout":
        logout(upstream)
    elif args.command == "serve":
        serve(upstream, parse_listen(args.listen))
    else:
        argv = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
        run_exec(upstream, parse_listen(args.listen), argv)


if __name__ == "__main__":
    main()
